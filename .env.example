# Server-only OpenAI credential. Never expose this as NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Affordable Responses API model with function calling.
OPENAI_MODEL=gpt-4o-mini

# Local SQLite state. The directory is git-ignored.
DATABASE_PATH=.data/jobform-support.sqlite

# Agent safety bounds.
AGENT_MAX_TURNS=10
AGENT_TOOL_MAX_ATTEMPTS=3
AGENT_TOOL_TIMEOUT_MS=5000

# Phase 5 voice transport. Both are server-configured; the browser only receives a 60-second Realtime client secret.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Staff console. ADMIN_PASSWORD must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_CONTROL_TOKEN=
# Optional extra perimeter: identity-aware reverse proxy injects x-jobform-admin-gateway after staff SSO.
ADMIN_GATEWAY_TOKEN=

# Host commerce integration. Share BUSINESS_INTEGRATION_SECRET only with the store backend.
BUSINESS_INTEGRATION_SECRET=
ECOMMERCE_BASE_URL=http://localhost:5011
INTERNAL_JOB_TOKEN=

# Customer support entry: portal, host, or all. Default all.
SUPPORT_ENTRY=all
SUPPORT_LAUNCH_SECRET=
APP_BASE_URL=http://localhost:3000
# On Render, set this to https://your-service.onrender.com after the first deploy.

# Seed the sample catalog on empty local databases. Keep false in production if the store syncs customers/orders.
SEED_SAMPLE_CATALOG=true

# Durable customer notifications. If unset, refund execution still succeeds and the outbox remains retryable.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_DELIVERY_MODE=worker

# Production readiness. In NODE_ENV=production OpenAI configuration is required automatically.
HEALTH_REQUIRE_OPENAI=false

# Privacy: customer message content is redacted from agent_runs in production unless explicitly enabled.
AUDIT_STORE_CUSTOMER_CONTENT=false
SUPPORT_CONTENT_RETENTION_DAYS=30
AGENT_CONTENT_RETENTION_DAYS=30
OPERATIONAL_EVENT_RETENTION_DAYS=30
NOTIFICATION_RECORD_RETENTION_DAYS=30
